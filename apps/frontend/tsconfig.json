{
  "extends": ["expo/tsconfig.base", "@ansari/tsconfig/base.json"],
  "compilerOptions": {
    // No `baseUrl`: TypeScript 6 rejects it (TS5101), and `paths` resolve
    // relative to this file without it.
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "uniwind-env.d.ts",
    "vendor/**/*.ts"
  ]
}
