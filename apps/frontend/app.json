{
  "expo": {
    "name": "Ansari",
    "owner": "ansari-project",
    "slug": "ansari-chat",
    "version": "4.0.0",
    "scheme": "ansarichat",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#E7E5E4",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E7E5E4",
      "dark": {
        "image": "./assets/images/splash-icon-dark.png",
        "resizeMode": "contain",
        "backgroundColor": "#13100E"
      }
    },
    "ios": {
      "bundleIdentifier": "chat.ansari.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "chat.ansari.app",
      "backgroundColor": "#E7E5E4",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundImage": "./assets/images/adaptive-icon-background.png",
        "backgroundColor": "#E7E5E4"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/icon.png",
      "output": "single",
      "backgroundColor": "#E7E5E4"
    },
    "plugins": ["expo-router", "expo-font", "expo-web-browser", "expo-video", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/e2f465a7-8007-4e83-91ba-4a9df4c5209a"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e2f465a7-8007-4e83-91ba-4a9df4c5209a"
      }
    }
  }
}
