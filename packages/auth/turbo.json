{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // tests/auth.http.test.ts reads apps/frontend/app.json (expo.scheme must be in
    // trustedOrigins). A file outside this package is NOT part of the task hash by
    // default, so without this input a warm cache replays the test when only the
    // manifest changes and the guard passes by not running.
    "test": {
      "inputs": ["$TURBO_DEFAULT$", ".env.ci", "$TURBO_ROOT$/apps/frontend/app.json"]
    }
  }
}
