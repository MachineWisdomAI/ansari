{
  "name": "ansari-faithful-answers",
  "version": "0.12.9",
  "private": true,
  "type": "module",
  "description": "Ansari's MCP application with the SAGA React FaithfulCard",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "start": "node dist/server/index.js",
    "dev": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:browser": "tsx test/browser.ts",
    "verify": "pnpm typecheck && pnpm build && pnpm test && pnpm test:browser",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/hono": "2.0.2",
    "@modelcontextprotocol/server": "2.3.1",
    "@saga-a2ui/components": "0.5.4-rc.1",
    "@saga-a2ui/core": "0.5.4-rc.1",
    "@saga-a2ui/mcp": "0.5.4-rc.1",
    "@saga-a2ui/react": "0.5.4-rc.1",
    "hono": "4.13.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.1",
    "tsx": "4.22.0",
    "typescript": "catalog:",
    "vite": "6.4.1",
    "vite-plugin-singlefile": "2.3.0"
  },
  "packageManager": "pnpm@10.33.0",
  "license": "MIT"
}
